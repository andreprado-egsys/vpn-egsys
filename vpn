#!/usr/bin/env python3
"""
vpn - Interface de Linha de Comando Universal para o vpn-egsys.
Compatível com Linux e macOS (Darwin).
Suporta protocolos Check Point (SNX) e IPsec (IKEv2).
"""

import os
import sys
import getpass
import base64
import argparse
from typing import List

# Permite importar o core relativo ao executável
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from core.vpn_manager import (
    discover_vpns,
    connect_vpn,
    disconnect_all,
    get_active_vpn,
    write_vpn_config,
    parse_vpn_config,
    get_config_dir,
    is_macos,
    is_linux,
)

BOLD = '\033[1m'
GREEN = '\033[0;32m'
YELLOW = '\033[1;33m'
RED = '\033[0;31m'
CYAN = '\033[96m'
NC = '\033[0m'


def cmd_list(args) -> int:
    """Lista todas as VPNs configuradas."""
    vpns = discover_vpns()
    active = get_active_vpn()
    active_id = active.get('id') if active else None

    print(f"\n{BOLD}=== VPNs Configuradas (egSYS) ==={NC}\n")
    if not vpns:
        print("  Nenhuma VPN configurada. Use 'vpn add' para cadastrar uma nova conexão.")
        return 0

    print(f"  {'ID':<10} {'PROTOCOLO':<10} {'STATUS':<15} {'NOME / LABEL':<25} {'SERVIDOR'}")
    print(f"  {'-'*10} {'-'*10} {'-'*15} {'-'*25} {'-'*20}")

    for vpn_id, info in sorted(vpns.items()):
        proto = info.get('protocol', 'snx').upper()
        is_act = (vpn_id == active_id) or (active_id == 'snx-active' and proto == 'SNX')
        status = f"{GREEN}● CONECTADO{NC}" if is_act else f"{YELLOW}○ Desconectado{NC}"
        label = info.get('label', '')
        server = info.get('server', '')
        print(f"  {CYAN}{vpn_id:<10}{NC} {proto:<10} {status:<24} {label:<25} {server}")

    print("")
    return 0


def cmd_status(args) -> int:
    """Exibe o status da conexão VPN atual."""
    active = get_active_vpn()
    print(f"\n{BOLD}=== Status de Conectividade VPN ==={NC}\n")

    if not active:
        print(f"  {YELLOW}✗ Nenhuma VPN conectada no momento.{NC}\n")
        return 0

    proto = active.get('protocol', 'snx').upper()
    label = active.get('label', 'Desconhecido')
    print(f"  {GREEN}✓ VPN Conectada:{NC} {BOLD}{label}{NC}")
    print(f"  • Protocolo:    {proto}")
    if active.get('server'):
        print(f"  • Servidor:     {active.get('server')}")
    if active.get('user'):
        print(f"  • Usuário:      {active.get('user')}")
    if active.get('details'):
        print(f"\n  Detalhes da sessão:\n  {active['details']}")
    print("")
    return 0


def cmd_connect(args) -> int:
    """Conecta a uma VPN especificada com sanitização e validação estrita."""
    raw_target = args.id.lower().strip()
    clean_target = ''.join(c for c in raw_target if c.isalnum())
    if not clean_target or clean_target != raw_target:
        print(f"{RED}✗ Erro de segurança: Identificador inválido. Apenas caracteres alfanuméricos são permitidos.{NC}")
        return 1

    target = clean_target if clean_target.startswith('vpn') else f'vpn{clean_target}'

    print(f"Iniciando conexão para {CYAN}{target}{NC}...")
    ok, msg = connect_vpn(target)
    if ok:
        print(f"{GREEN}✓ {msg}{NC}")
        return 0
    else:
        print(f"{RED}✗ {msg}{NC}")
        return 1


def cmd_disconnect(args) -> int:
    """Desconecta todas as sessões ativas."""
    print("Desconectando sessões VPN ativas...")
    ok, msg = disconnect_all()
    if ok:
        print(f"{GREEN}✓ {msg}{NC}")
        return 0
    else:
        print(f"{RED}✗ {msg}{NC}")
        return 1


def cmd_add(args) -> int:
    """Assistente interativo para adicionar nova VPN (SNX ou IPsec)."""
    print(f"\n{BOLD}=== Adicionar Nova VPN ==={NC}\n")

    print("Selecione o protocolo da VPN:")
    print("  [1] Check Point SSL Network Extender (SNX)")
    print("  [2] IPsec / IKEv2")
    choice = input("Opção [1/2] (padrão 1): ").strip()
    protocol = 'ipsec' if choice == '2' else 'snx'

    vpn_id = input("Identificador da VPN (ex: ro, pr, am, sc, to): ").strip().lower().replace(' ', '')
    if not vpn_id:
        print(f"{RED}Erro: Identificador obrigatório.{NC}")
        return 1
    if not vpn_id.startswith('vpn'):
        vpn_id = f'vpn{vpn_id}'

    server = input("Servidor / Gateway (IP ou FQDN): ").strip()
    if not server:
        print(f"{RED}Erro: Servidor obrigatório.{NC}")
        return 1

    user = input("Usuário de autenticação: ").strip()
    passwd = getpass.getpass("Senha de autenticação: ").strip()
    if not passwd:
        print(f"{RED}Erro: Senha não pode ser vazia.{NC}")
        return 1
    passwd_b64 = base64.b64encode(passwd.encode()).decode()

    ipsec_type = 'ikev2'
    psk_b64 = ''
    routes = ''

    if protocol == 'ipsec':
        type_choice = input("Tipo de IPsec [ikev2/xauth] (padrão ikev2): ").strip().lower()
        if type_choice in ['xauth', 'ikev1']:
            ipsec_type = type_choice

        psk = getpass.getpass("Chave Pré-compartilhada / PSK (se aplicável, Enter para pular): ").strip()
        if psk:
            psk_b64 = base64.b64encode(psk.encode()).decode()

        routes = input("Rotas de rede a injetar (separadas por vírgula, ex: 10.0.0.0/8, Enter para pular): ").strip()

    extra_opts = {}
    if vpn_id == 'vpnam' and protocol == 'snx':
        extra_opts['ike-persist'] = 'true'

    conf_file = write_vpn_config(
        vpn_id=vpn_id,
        server=server,
        user=user,
        password_b64=passwd_b64,
        protocol=protocol,
        ipsec_type=ipsec_type,
        psk_b64=psk_b64,
        routes=routes,
        extra_options=extra_opts
    )

    print(f"\n{GREEN}✓ VPN {vpn_id} ({protocol.upper()}) cadastrada com sucesso!{NC}")
    print(f"Arquivo de configuração salvo em: {conf_file}")
    return 0


def cmd_remove(args) -> int:
    """Remove uma VPN configurada com validação estrita."""
    raw_target = args.id.lower().strip()
    clean_target = ''.join(c for c in raw_target if c.isalnum())
    if not clean_target or clean_target != raw_target:
        print(f"{RED}✗ Erro de segurança: Identificador inválido. Apenas caracteres alfanuméricos são permitidos.{NC}")
        return 1

    target = clean_target if clean_target.startswith('vpn') else f'vpn{clean_target}'

    cfg_dir = get_config_dir()
    conf_file = os.path.join(cfg_dir, f'{target}.conf')

    if not os.path.exists(conf_file):
        print(f"{RED}VPN '{target}' não encontrada em {conf_file}.{NC}")
        return 1

    confirm = input(f"Tem certeza que deseja remover {target}? (s/N): ").strip().lower()
    if confirm in ['s', 'sim', 'y', 'yes']:
        os.remove(conf_file)
        print(f"{GREEN}✓ VPN {target} removida com sucesso.{NC}")
        return 0
    else:
        print("Operação cancelada.")
        return 0


def main():
    # Suporte a atalhos rápidos diretos:
    # 'vpn ro' -> conecta vpnro
    # 'vpn off' -> desconecta
    # 'vpn status' -> status
    raw_args = sys.argv[1:]
    if len(raw_args) == 1 and raw_args[0] not in ['-h', '--help', 'list', 'status', 'add', 'remove', 'connect', 'disconnect', 'off']:
        # Assume que o argumento é o ID da VPN
        sys.argv = [sys.argv[0], 'connect', raw_args[0]]
    elif len(raw_args) == 1 and raw_args[0] == 'off':
        sys.argv = [sys.argv[0], 'disconnect']

    parser = argparse.ArgumentParser(
        prog='vpn',
        description='Gerenciador Universal de VPNs egSYS (SNX & IPsec) para Linux e macOS'
    )
    subparsers = parser.add_subparsers(dest='command', help='Comandos disponíveis')

    # list
    p_list = subparsers.add_parser('list', help='Listar todas as VPNs configuradas')
    p_list.set_defaults(func=cmd_list)

    # status
    p_status = subparsers.add_parser('status', help='Verificar status da conexão atual')
    p_status.set_defaults(func=cmd_status)

    # connect
    p_conn = subparsers.add_parser('connect', help='Conectar a uma VPN')
    p_conn.add_argument('id', help='Identificador da VPN (ex: ro, pr, am, sc, to)')
    p_conn.set_defaults(func=cmd_connect)

    # disconnect
    p_disc = subparsers.add_parser('disconnect', help='Desconectar a VPN ativa')
    p_disc.set_defaults(func=cmd_disconnect)

    # add
    p_add = subparsers.add_parser('add', help='Adicionar nova VPN interativamente')
    p_add.set_defaults(func=cmd_add)

    # remove
    p_rm = subparsers.add_parser('remove', help='Remover uma VPN configurada')
    p_rm.add_argument('id', help='Identificador da VPN a remover')
    p_rm.set_defaults(func=cmd_remove)

    args = parser.parse_args()
    if hasattr(args, 'func'):
        sys.exit(args.func(args))
    else:
        cmd_list(None)


if __name__ == '__main__':
    main()
