#!/usr/bin/env python3
"""vpn-tray - Monitor de VPN snx-rs na bandeja do sistema."""

import gi
import subprocess
import os
import signal
import glob

gi.require_version('Gtk', '3.0')
gi.require_version('AyatanaAppIndicator3', '0.1')
from gi.repository import Gtk, AyatanaAppIndicator3, GLib

ICON_DIR = os.path.expanduser('~/.local/share/icons/vpn-egsys')
CONFIG_DIR = os.path.expanduser('~/.config/snx-rs')

KNOWN_LABELS = {
    'vpnro': 'VPN RO - Rondônia',
    'vpnpr': 'VPN PR - Paraná',
    'vpnam': 'VPN AM - Amazonas',
    'vpnmt': 'VPN MT - Mato Grosso',
    'vpnsc': 'VPN SC - Santa Catarina',
    'vpnto': 'VPN TO - Tocantins',
    'vpnprgp': 'VPN PR GP',
}


def discover_vpns():
    configs = {}
    for conf in sorted(glob.glob(os.path.join(CONFIG_DIR, 'vpn*.conf'))):
        name = os.path.basename(conf).replace('.conf', '')
        label = KNOWN_LABELS.get(name, f'VPN {name[3:].upper()}')
        configs[name] = (label, os.path.basename(conf))
    return configs


class VPNTray:
    def __init__(self):
        self.configs = discover_vpns()
        self.indicator = AyatanaAppIndicator3.Indicator.new_with_path(
            'vpn-monitor', 'vpn-disconnected',
            AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
            ICON_DIR)
        self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
        self.indicator.set_title('VPN Desconectada')
        self.build_menu()
        GLib.timeout_add_seconds(3, self.check_status)
        self.check_status()

    def build_menu(self):
        menu = Gtk.Menu()

        self.status_item = Gtk.MenuItem(label='✗ Desconectado')
        self.status_item.set_sensitive(False)
        menu.append(self.status_item)
        menu.append(Gtk.SeparatorMenuItem())

        for key, (label, _) in self.configs.items():
            item = Gtk.MenuItem(label=f'Conectar {label}')
            item.connect('activate', self.on_connect, key)
            menu.append(item)

        menu.append(Gtk.SeparatorMenuItem())

        disc = Gtk.MenuItem(label='Desconectar')
        disc.connect('activate', self.on_disconnect)
        menu.append(disc)

        menu.append(Gtk.SeparatorMenuItem())

        config_item = Gtk.MenuItem(label='⚙ Configurar VPNs...')
        config_item.connect('activate', self.on_configure)
        menu.append(config_item)

        menu.append(Gtk.SeparatorMenuItem())

        quit_item = Gtk.MenuItem(label='Sair')
        quit_item.connect('activate', self.on_quit)
        menu.append(quit_item)

        menu.show_all()
        self.indicator.set_menu(menu)

    def get_active_vpn_name(self):
        try:
            r = subprocess.run(['snxctl', 'status'],
                               capture_output=True, text=True, timeout=5)
            output = r.stdout.strip() if r.returncode == 0 else ""
            if not output or "desconectado" in output.lower() or "disconnected" in output.lower():
                return None
        except Exception:
            return None

        active_conf = os.path.join(CONFIG_DIR, 'snx-rs.conf')
        if os.path.exists(active_conf):
            try:
                with open(active_conf) as f:
                    active_content = f.read().strip()
                for key, (label, conf_file) in self.configs.items():
                    conf_path = os.path.join(CONFIG_DIR, conf_file)
                    if os.path.exists(conf_path):
                        with open(conf_path) as f:
                            if f.read().strip() == active_content:
                                return label
            except Exception:
                pass
        return 'VPN Conectada'

    def check_status(self):
        vpn = self.get_active_vpn_name()
        if vpn:
            self.indicator.set_icon_full('vpn-connected', f'Conectado: {vpn}')
            self.indicator.set_title(f'VPN: {vpn}')
            self.status_item.set_label(f'✓ {vpn}')
        else:
            self.indicator.set_icon_full('vpn-disconnected', 'Desconectado')
            self.indicator.set_title('VPN Desconectada')
            self.status_item.set_label('✗ Desconectado')
        return True

    def on_connect(self, widget, key):
        label, conf_file = self.configs[key]
        conf_path = os.path.join(CONFIG_DIR, conf_file)
        snx_conf = os.path.join(CONFIG_DIR, 'snx-rs.conf')

        subprocess.run(['snxctl', 'disconnect'], capture_output=True, timeout=5)
        for k, (lbl, _) in self.configs.items():
            subprocess.run(['nmcli', 'connection', 'down', lbl],
                          capture_output=True, timeout=3)
        try:
            with open(conf_path) as f:
                content = f.read()
            with open(snx_conf, 'w') as f:
                f.write(content)
        except Exception:
            pass
        subprocess.Popen(['snxctl', 'connect'])
        subprocess.Popen(['nmcli', 'connection', 'up', label])

    def on_disconnect(self, widget):
        subprocess.run(['snxctl', 'disconnect'], capture_output=True, timeout=5)
        for key, (label, _) in self.configs.items():
            subprocess.run(['nmcli', 'connection', 'down', label],
                          capture_output=True, timeout=3)

    def on_configure(self, widget):
        """Abre janela para adicionar/remover VPNs."""
        dialog = Gtk.Dialog(title="Configurar VPNs", flags=0)
        dialog.set_default_size(400, 300)
        box = dialog.get_content_area()

        # Lista de VPNs existentes com botão remover
        frame = Gtk.Frame(label="VPNs configuradas")
        listbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        listbox.set_margin_top(10)
        listbox.set_margin_bottom(10)
        listbox.set_margin_start(10)
        listbox.set_margin_end(10)

        for key, (label, conf_file) in self.configs.items():
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            btn = Gtk.Button(label="Remover")
            btn.connect('clicked', self.on_remove_vpn, key, dialog)
            row.pack_end(btn, False, False, 0)
            listbox.pack_start(row, False, False, 0)

        frame.add(listbox)
        box.pack_start(frame, True, True, 10)

        # Seção adicionar
        frame2 = Gtk.Frame(label="Adicionar nova VPN")
        grid = Gtk.Grid(column_spacing=10, row_spacing=5)
        grid.set_margin_top(10)
        grid.set_margin_bottom(10)
        grid.set_margin_start(10)
        grid.set_margin_end(10)

        grid.attach(Gtk.Label(label="ID (ex: vpnsc):", xalign=0), 0, 0, 1, 1)
        self.entry_id = Gtk.Entry()
        grid.attach(self.entry_id, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Servidor:", xalign=0), 0, 1, 1, 1)
        self.entry_server = Gtk.Entry()
        grid.attach(self.entry_server, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label="Usuário:", xalign=0), 0, 2, 1, 1)
        self.entry_user = Gtk.Entry()
        grid.attach(self.entry_user, 1, 2, 1, 1)

        grid.attach(Gtk.Label(label="Senha:", xalign=0), 0, 3, 1, 1)
        self.entry_pass = Gtk.Entry()
        self.entry_pass.set_visibility(False)
        grid.attach(self.entry_pass, 1, 3, 1, 1)

        btn_add = Gtk.Button(label="Adicionar")
        btn_add.connect('clicked', self.on_add_vpn, dialog)
        grid.attach(btn_add, 1, 4, 1, 1)

        frame2.add(grid)
        box.pack_start(frame2, False, False, 10)

        dialog.show_all()
        dialog.run()
        dialog.destroy()

    def on_add_vpn(self, widget, dialog):
        vpn_id = self.entry_id.get_text().strip()
        server = self.entry_server.get_text().strip()
        user = self.entry_user.get_text().strip()
        passwd = self.entry_pass.get_text().strip()

        if not all([vpn_id, server, user, passwd]):
            return

        import base64
        pass_b64 = base64.b64encode(passwd.encode()).decode()
        conf_path = os.path.join(CONFIG_DIR, f'{vpn_id}.conf')
        with open(conf_path, 'w') as f:
            f.write(f'server-name={server}\n')
            f.write(f'user-name={user}\n')
            f.write(f'password={pass_b64}\n')
            f.write('ignore-server-cert=true\n')
            f.write('login-type=vpn\n')
        os.chmod(conf_path, 0o600)

        # Recarrega e reconstrói menu
        self.configs = discover_vpns()
        self.build_menu()
        dialog.destroy()
        self.on_configure(None)

    def on_remove_vpn(self, widget, key, dialog):
        conf_path = os.path.join(CONFIG_DIR, f'{key}.conf')
        if os.path.exists(conf_path):
            os.remove(conf_path)
        # Remove conexão NM
        label = self.configs.get(key, ('', ''))[0]
        subprocess.run(['nmcli', 'connection', 'delete', label],
                       capture_output=True, timeout=5)
        self.configs = discover_vpns()
        self.build_menu()
        dialog.destroy()
        self.on_configure(None)

    def on_quit(self, widget):
        Gtk.main_quit()


if __name__ == '__main__':
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    VPNTray()
    Gtk.main()
