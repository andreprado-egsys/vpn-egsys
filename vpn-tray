#!/usr/bin/env python3
"""
vpn-tray - Monitor Universal de VPN (SNX & IPsec) na bandeja do sistema.
Compatível com Linux (Gtk / AyatanaAppIndicator) e macOS (pystray / AppKit nativo).
"""

import os
import sys
import glob
import signal
import platform
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from core.vpn_manager import (
    discover_vpns,
    connect_vpn,
    disconnect_all,
    get_active_vpn,
    write_vpn_config,
    parse_vpn_config,
    get_config_dir,
    is_macos,
    is_linux,
)

IS_MACOS = is_macos()
IS_LINUX = is_linux()

# Configurações de caminhos de ícones
ICON_DIR = os.path.expanduser('~/.local/share/icons/vpn-egsys')
if IS_MACOS:
    ICON_DIR = os.path.expanduser('~/Library/Application Support/vpn-egsys/icons')
    if not os.path.exists(ICON_DIR):
        ICON_DIR = os.path.join(SCRIPT_DIR, 'icons')


# -------------------------------------------------------------
# BACKEND LINUX (GTK 3 + AyatanaAppIndicator3)
# -------------------------------------------------------------
def run_linux_tray():
    import pwd

    def setup_display():
        uid = os.getuid()
        if not os.environ.get('DISPLAY'):
            for x in sorted(glob.glob('/tmp/.X11-unix/X*')):
                display_num = os.path.basename(x).replace('X', '')
                try:
                    stat = os.stat(x)
                    if stat.st_uid == uid:
                        os.environ['DISPLAY'] = f':{display_num}'
                        break
                except Exception:
                    continue
            if not os.environ.get('DISPLAY'):
                for x in sorted(glob.glob('/tmp/.X11-unix/X*')):
                    display_num = os.path.basename(x).replace('X', '')
                    os.environ['DISPLAY'] = f':{display_num}'
                    break

        if not os.environ.get('DBUS_SESSION_BUS_ADDRESS'):
            dbus_path = f'/run/user/{uid}/bus'
            if os.path.exists(dbus_path):
                os.environ['DBUS_SESSION_BUS_ADDRESS'] = f'unix:path={dbus_path}'

        if not os.environ.get('DISPLAY'):
            print("ERRO: Nenhum display encontrado. Execute dentro de uma sessão gráfica.", file=sys.stderr)
            sys.exit(1)

    setup_display()

    import gi
    gi.require_version('Gtk', '3.0')
    try:
        gi.require_version('AyatanaAppIndicator3', '0.1')
        from gi.repository import AyatanaAppIndicator3 as AppIndicator
    except (ValueError, ImportError):
        try:
            gi.require_version('AppIndicator3', '0.1')
            from gi.repository import AppIndicator3 as AppIndicator
        except (ValueError, ImportError):
            print("ERRO: AyatanaAppIndicator3 ou AppIndicator3 não encontrado.", file=sys.stderr)
            sys.exit(1)

    from gi.repository import Gtk, GLib

    icon_connected = 'network-vpn'
    icon_disconnected = 'network-vpn-disconnected'

    theme = Gtk.IconTheme.get_default()
    if not theme.has_icon('network-vpn'):
        icon_connected = 'vpn-connected'
        icon_disconnected = 'vpn-disconnected'

    class LinuxVPNTray:
        def __init__(self):
            self.configs = discover_vpns()
            self.indicator = AppIndicator.Indicator.new_with_path(
                'vpn-monitor', icon_disconnected,
                AppIndicator.IndicatorCategory.APPLICATION_STATUS,
                ICON_DIR)
            self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
            self.indicator.set_title('VPN Desconectada')
            self.build_menu()
            GLib.timeout_add_seconds(3, self.check_status)
            self.check_status()

        def build_menu(self):
            menu = Gtk.Menu()

            self.status_item = Gtk.MenuItem(label='✗ Desconectado')
            self.status_item.set_sensitive(False)
            menu.append(self.status_item)
            menu.append(Gtk.SeparatorMenuItem())

            snx_vpns = {k: v for k, v in self.configs.items() if v.get('protocol', 'snx').lower() == 'snx'}
            ipsec_vpns = {k: v for k, v in self.configs.items() if v.get('protocol', 'snx').lower() == 'ipsec'}

            # --- SEÇÃO IPSEC / IKEv2 ---
            header_ipsec = Gtk.MenuItem(label='── IPsec / IKEv2 ──')
            header_ipsec.set_sensitive(False)
            menu.append(header_ipsec)

            if ipsec_vpns:
                for key, info in sorted(ipsec_vpns.items()):
                    label = info.get('label', key)
                    item = Gtk.MenuItem(label=f'Conectar {label} [IPsec]')
                    item.connect('activate', self.on_connect, key)
                    menu.append(item)
            else:
                empty_ipsec = Gtk.MenuItem(label='  (Nenhum túnel IPsec configurado)')
                empty_ipsec.set_sensitive(False)
                menu.append(empty_ipsec)

            add_ipsec_item = Gtk.MenuItem(label='  + Adicionar Conexão IPsec (IKEv2)...')
            add_ipsec_item.connect('activate', lambda w: self.on_add_direct(default_proto='ipsec'))
            menu.append(add_ipsec_item)

            menu.append(Gtk.SeparatorMenuItem())

            # --- SEÇÃO CHECK POINT SSL (SNX) ---
            header_snx = Gtk.MenuItem(label='── Check Point SSL (SNX) ──')
            header_snx.set_sensitive(False)
            menu.append(header_snx)

            if snx_vpns:
                for key, info in sorted(snx_vpns.items()):
                    label = info.get('label', key)
                    item = Gtk.MenuItem(label=f'Conectar {label} [SNX]')
                    item.connect('activate', self.on_connect, key)
                    menu.append(item)
            else:
                empty_snx = Gtk.MenuItem(label='  (Nenhum túnel SNX configurado)')
                empty_snx.set_sensitive(False)
                menu.append(empty_snx)

            add_snx_item = Gtk.MenuItem(label='  + Adicionar Conexão Check Point (SNX)...')
            add_snx_item.connect('activate', lambda w: self.on_add_direct(default_proto='snx'))
            menu.append(add_snx_item)

            menu.append(Gtk.SeparatorMenuItem())

            disc = Gtk.MenuItem(label='Desconectar')
            disc.connect('activate', self.on_disconnect)
            menu.append(disc)

            menu.append(Gtk.SeparatorMenuItem())

            config_item = Gtk.MenuItem(label='⚙ Configurar VPNs (SNX & IPsec)...')
            config_item.connect('activate', self.on_configure)
            menu.append(config_item)

            menu.append(Gtk.SeparatorMenuItem())

            quit_item = Gtk.MenuItem(label='Sair')
            quit_item.connect('activate', self.on_quit)
            menu.append(quit_item)

            menu.show_all()
            self.indicator.set_menu(menu)

        def check_status(self):
            active = get_active_vpn()
            if active:
                label = active.get('label', 'VPN Conectada')
                proto = active.get('protocol', 'snx').upper()
                self.indicator.set_icon_full(icon_connected, f'Conectado: {label} [{proto}]')
                self.indicator.set_title(f'VPN: {label}')
                self.status_item.set_label(f'✓ {label} [{proto}]')
            else:
                self.indicator.set_icon_full(icon_disconnected, 'Desconectado')
                self.indicator.set_title('VPN Desconectada')
                self.status_item.set_label('✗ Desconectado')
            return True

        def on_connect(self, widget, key):
            connect_vpn(key)

        def on_disconnect(self, widget):
            disconnect_all()

        def on_add_direct(self, default_proto='ipsec'):
            """Abre direto o diálogo de adicionar nova VPN com protocolo pré-selecionado."""
            self.show_vpn_dialog(default_proto=default_proto)

        def on_configure(self, widget):
            self.show_management_dialog()

        def show_management_dialog(self):
            dialog = Gtk.Dialog(title="Gerenciador de VPNs (egSYS)", flags=0)
            dialog.set_default_size(520, 500)
            box = dialog.get_content_area()

            # Lista de VPNs existentes
            frame = Gtk.Frame(label="VPNs Configuradas")
            listbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            listbox.set_margin_top(10)
            listbox.set_margin_bottom(10)
            listbox.set_margin_start(10)
            listbox.set_margin_end(10)

            if not self.configs:
                listbox.pack_start(Gtk.Label(label="Nenhuma VPN configurada."), False, False, 0)

            for key, info in sorted(self.configs.items()):
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                lbl = info.get('label', key)
                proto = info.get('protocol', 'snx').upper()
                proto_badge = f"[{proto}]"
                lbl_widget = Gtk.Label(label=f"<b>{lbl}</b>  <small>{proto_badge}</small>", use_markup=True, xalign=0)
                row.pack_start(lbl_widget, True, True, 0)

                btn_conn = Gtk.Button(label="Conectar")
                btn_conn.connect('clicked', lambda w, k=key: (connect_vpn(k), dialog.destroy()))
                row.pack_end(btn_conn, False, False, 0)

                btn_edit = Gtk.Button(label="Editar")
                btn_edit.connect('clicked', self.on_edit_vpn, key, dialog)
                row.pack_end(btn_edit, False, False, 0)

                btn_rm = Gtk.Button(label="Remover")
                btn_rm.connect('clicked', self.on_remove_vpn, key, dialog)
                row.pack_end(btn_rm, False, False, 0)

                listbox.pack_start(row, False, False, 0)

            frame.add(listbox)
            box.pack_start(frame, True, True, 8)

            # Botões de Adicionar
            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            btn_box.set_margin_top(5)
            btn_box.set_margin_bottom(10)
            btn_box.set_margin_start(10)
            btn_box.set_margin_end(10)

            btn_add_ipsec = Gtk.Button(label="+ Adicionar Nova VPN IPsec / IKEv2")
            btn_add_ipsec.connect('clicked', lambda w: (dialog.destroy(), self.show_vpn_dialog(default_proto='ipsec')))
            btn_box.pack_start(btn_add_ipsec, True, True, 0)

            btn_add_snx = Gtk.Button(label="+ Adicionar Nova VPN Check Point (SNX)")
            btn_add_snx.connect('clicked', lambda w: (dialog.destroy(), self.show_vpn_dialog(default_proto='snx')))
            btn_box.pack_start(btn_add_snx, True, True, 0)

            box.pack_start(btn_box, False, False, 0)

            dialog.add_button("Fechar", Gtk.ResponseType.CLOSE)
            dialog.show_all()
            dialog.run()
            dialog.destroy()

        def show_vpn_dialog(self, default_proto='ipsec', vpn_key=None):
            """Diálogo completo de Adicionar ou Editar VPN com campos dinâmicos por protocolo."""
            is_edit = vpn_key is not None
            title = f"Editar VPN: {vpn_key}" if is_edit else "Adicionar Nova VPN (egSYS)"
            dialog = Gtk.Dialog(title=title, flags=0)
            dialog.set_default_size(460, 360)
            box = dialog.get_content_area()

            grid = Gtk.Grid(column_spacing=10, row_spacing=8)
            grid.set_margin_top(15)
            grid.set_margin_bottom(15)
            grid.set_margin_start(15)
            grid.set_margin_end(15)

            current_data = {}
            if is_edit:
                cfg_dir = get_config_dir()
                conf_path = os.path.join(cfg_dir, f'{vpn_key}.conf')
                if os.path.exists(conf_path):
                    current_data = parse_vpn_config(conf_path)

            row = 0

            # 1. Preset / Modelos rápidos (apenas em modo adicionar)
            combo_preset = None
            if not is_edit:
                grid.attach(Gtk.Label(label="<b>Modelo Rápido:</b>", use_markup=True, xalign=0), 0, row, 1, 1)
                combo_preset = Gtk.ComboBoxText()
                combo_preset.append('custom', 'Personalizado')
                combo_preset.append('sc', 'Santa Catarina (SC) — IPsec / IKEv2')
                combo_preset.append('to', 'Tocantins (TO) — IPsec / IKEv2')
                combo_preset.append('ro', 'Rondônia (RO) — Check Point SNX')
                combo_preset.append('pr', 'Paraná (PR) — Check Point SNX')
                combo_preset.append('am', 'Amazonas (AM) — Check Point SNX')
                combo_preset.set_active(0)
                grid.attach(combo_preset, 1, row, 1, 1)
                row += 1

            # 2. Protocolo
            grid.attach(Gtk.Label(label="<b>Protocolo:</b>", use_markup=True, xalign=0), 0, row, 1, 1)
            combo_proto = Gtk.ComboBoxText()
            combo_proto.append('ipsec', 'IPsec / IKEv2 (strongSwan)')
            combo_proto.append('snx', 'Check Point SSL (SNX)')
            init_proto = current_data.get('protocol', default_proto).lower()
            combo_proto.set_active(0 if init_proto == 'ipsec' else 1)
            grid.attach(combo_proto, 1, row, 1, 1)
            row += 1

            # 3. Identificador
            grid.attach(Gtk.Label(label="Estado / ID (ex: sc, ro, pr):", xalign=0), 0, row, 1, 1)
            entry_id = Gtk.Entry()
            if is_edit:
                entry_id.set_text(vpn_key)
                entry_id.set_sensitive(False)
            else:
                entry_id.set_placeholder_text("sc, ro, pr, am, to...")
            grid.attach(entry_id, 1, row, 1, 1)
            row += 1

            # 4. Servidor
            grid.attach(Gtk.Label(label="Servidor / Gateway:", xalign=0), 0, row, 1, 1)
            entry_srv = Gtk.Entry()
            entry_srv.set_text(current_data.get('server-name', ''))
            entry_srv.set_placeholder_text("IP ou Hostname do gateway")
            grid.attach(entry_srv, 1, row, 1, 1)
            row += 1

            # 5. Usuário
            grid.attach(Gtk.Label(label="Usuário:", xalign=0), 0, row, 1, 1)
            entry_usr = Gtk.Entry()
            entry_usr.set_text(current_data.get('user-name', ''))
            grid.attach(entry_usr, 1, row, 1, 1)
            row += 1

            # 6. Senha
            grid.attach(Gtk.Label(label="Senha:", xalign=0), 0, row, 1, 1)
            entry_pwd = Gtk.Entry()
            entry_pwd.set_visibility(False)
            if is_edit:
                entry_pwd.set_placeholder_text("deixe vazio para manter atual")
            grid.attach(entry_pwd, 1, row, 1, 1)
            row += 1

            # 7. PSK (Pre-Shared Key - IPsec)
            lbl_psk = Gtk.Label(label="Chave PSK (IPsec):", xalign=0)
            entry_psk = Gtk.Entry()
            entry_psk.set_visibility(False)
            entry_psk.set_placeholder_text("Chave pré-compartilhada (opcional)")
            grid.attach(lbl_psk, 0, row, 1, 1)
            grid.attach(entry_psk, 1, row, 1, 1)
            row += 1

            # 8. Rotas
            lbl_routes = Gtk.Label(label="Rotas adicionais:", xalign=0)
            entry_routes = Gtk.Entry()
            entry_routes.set_text(current_data.get('routes', ''))
            entry_routes.set_placeholder_text("ex: 10.0.0.0/8, 172.23.0.0/16")
            grid.attach(lbl_routes, 0, row, 1, 1)
            grid.attach(entry_routes, 1, row, 1, 1)
            row += 1

            def update_fields_visibility():
                proto = combo_proto.get_active_id() or 'ipsec'
                is_ipsec_sel = (proto == 'ipsec')
                lbl_psk.set_visible(is_ipsec_sel)
                entry_psk.set_visible(is_ipsec_sel)

            combo_proto.connect('changed', lambda w: update_fields_visibility())
            update_fields_visibility()

            # Preset handler
            if combo_preset:
                def on_preset_changed(combo):
                    pid = combo.get_active_id()
                    if pid == 'sc':
                        combo_proto.set_active_id('ipsec')
                        entry_id.set_text('sc')
                    elif pid == 'to':
                        combo_proto.set_active_id('ipsec')
                        entry_id.set_text('to')
                    elif pid == 'ro':
                        combo_proto.set_active_id('snx')
                        entry_id.set_text('ro')
                        entry_srv.set_text('131.72.155.42')
                    elif pid == 'pr':
                        combo_proto.set_active_id('snx')
                        entry_id.set_text('pr')
                        entry_srv.set_text('acessoremoto.pr.gov.br')
                    elif pid == 'am':
                        combo_proto.set_active_id('snx')
                        entry_id.set_text('am')
                        entry_srv.set_text('sslvpn.prodam.am.gov.br')
                    update_fields_visibility()

                combo_preset.connect('changed', on_preset_changed)

            box.pack_start(grid, True, True, 0)
            dialog.add_button("Cancelar", Gtk.ResponseType.CANCEL)
            dialog.add_button("Salvar VPN", Gtk.ResponseType.OK)
            dialog.show_all()
            update_fields_visibility()

            resp = dialog.run()
            if resp == Gtk.ResponseType.OK:
                raw_id = entry_id.get_text().strip().lower().replace(' ', '')
                server = entry_srv.get_text().strip() or current_data.get('server-name', '')
                user = entry_usr.get_text().strip() or current_data.get('user-name', '')
                pwd = entry_pwd.get_text().strip()
                protocol = combo_proto.get_active_id() or 'snx'
                psk = entry_psk.get_text().strip()
                routes = entry_routes.get_text().strip()

                import base64
                if pwd:
                    pass_b64 = base64.b64encode(pwd.encode()).decode()
                else:
                    pass_b64 = current_data.get('password', '')

                psk_b64 = base64.b64encode(psk.encode()).decode() if psk else current_data.get('psk', '')

                extra_opts = {}
                if raw_id in ['am', 'vpnam'] and protocol == 'snx':
                    extra_opts['ike-persist'] = 'true'

                if raw_id and server and user and (pass_b64 or pwd):
                    write_vpn_config(
                        vpn_id=raw_id,
                        server=server,
                        user=user,
                        password_b64=pass_b64,
                        protocol=protocol,
                        psk_b64=psk_b64,
                        routes=routes,
                        extra_options=extra_opts
                    )

            dialog.destroy()
            self.configs = discover_vpns()
            self.build_menu()

        def on_edit_vpn(self, widget, key, parent_dialog):
            parent_dialog.destroy()
            self.show_vpn_dialog(vpn_key=key)

        def on_remove_vpn(self, widget, key, dialog):
            cfg_dir = get_config_dir()
            conf_path = os.path.join(cfg_dir, f'{key}.conf')
            if os.path.exists(conf_path):
                os.remove(conf_path)

            label = self.configs.get(key, {}).get('label', '')
            if label:
                subprocess.run(['nmcli', 'connection', 'delete', label], capture_output=True, timeout=5)

            self.configs = discover_vpns()
            self.build_menu()
            dialog.destroy()
            self.show_management_dialog()

        def on_quit(self, widget):
            Gtk.main_quit()

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    LinuxVPNTray()
    Gtk.main()


# -------------------------------------------------------------
# BACKEND MACOS (Darwin / pystray ou Background Monitor)
# -------------------------------------------------------------
def run_macos_tray():
    """Executa o Tray no macOS usando pystray / AppKit nativo."""
    try:
        import pystray
        from PIL import Image, ImageDraw

        def create_icon_image(connected: bool):
            width = 64
            height = 64
            image = Image.new('RGBA', (width, height), (0, 0, 0, 0))
            dc = ImageDraw.Draw(image)
            color = (34, 197, 94, 255) if connected else (156, 163, 175, 255)
            dc.ellipse((8, 8, 56, 56), fill=color)
            return image

        def on_connect_clicked(icon, item):
            vpn_id = str(item)
            connect_vpn(vpn_id)
            update_tray(icon)

        def on_disconnect_clicked(icon, item):
            disconnect_all()
            update_tray(icon)

        def on_quit_clicked(icon, item):
            icon.stop()

        def build_macos_menu():
            configs = discover_vpns()
            active = get_active_vpn()
            status_text = f"✓ {active['label']}" if active else "✗ Desconectado"

            items = [
                pystray.MenuItem(status_text, lambda: None, enabled=False),
                pystray.Menu.SEPARATOR,
            ]

            for key, info in sorted(configs.items()):
                lbl = info.get('label', key)
                proto = info.get('protocol', 'snx').upper()
                items.append(pystray.MenuItem(f"Conectar {lbl} [{proto}]", on_connect_clicked))

            items.extend([
                pystray.Menu.SEPARATOR,
                pystray.MenuItem("Desconectar", on_disconnect_clicked),
                pystray.Menu.SEPARATOR,
                pystray.MenuItem("Sair", on_quit_clicked),
            ])
            return pystray.Menu(*items)

        def update_tray(icon):
            active = get_active_vpn()
            icon.icon = create_icon_image(bool(active))
            icon.title = f"egSYS VPN: {active['label']}" if active else "egSYS VPN: Desconectado"
            icon.menu = build_macos_menu()

        icon = pystray.Icon(
            'vpn-egsys',
            icon=create_icon_image(False),
            title='egSYS VPN Monitor',
            menu=build_macos_menu()
        )
        icon.run()

    except ImportError:
        print("[!] Módulo 'pystray' ou 'Pillow' não instalado no macOS.")
        print("    Para habilitar o ícone na barra de menus do macOS, instale:")
        print("    pip3 install pystray Pillow")
        print("\n    O CLI 'vpn' está 100% disponível para uso no terminal: 'vpn list', 'vpn connect <id>'")
        sys.exit(0)


def main():
    if IS_MACOS:
        run_macos_tray()
    else:
        run_linux_tray()


if __name__ == '__main__':
    main()
